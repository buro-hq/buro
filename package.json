{
  "name": "buro",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/start-dev.mjs",
    "dev": "vite --host 127.0.0.1 --port 4317",
    "daemon": "node daemon/main.ts",
    "cli": "node cli/main.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4327 --strictPort",
    "typecheck": "tsc -p agent/contracts/tsconfig.json && tsc -p agent/providers/tsconfig.json && tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "node --test --test-reporter=./tooling/test-reporter.mjs \"tests/**/*.test.ts\"",
    "test:verbose": "node --test \"tests/**/*.test.ts\"",
    "check:ui": "node --test tests/modules-ui.test.ts",
    "format": "npm run format:code && npm run format:assets",
    "format:check": "eslint --config tooling/eslint-style.mjs . && prettier --check .",
    "evaluate:model": "node scripts/evaluate-model.ts",
    "format:code": "eslint --config tooling/eslint-style.mjs --fix .",
    "format:assets": "prettier --write .",
    "lint": "eslint .",
    "fix": "eslint --fix . && npm run format:assets",
    "check": "npm run lint && prettier --check . && npm run typecheck",
    "test:style": "node --test tests/code-style.test.ts"
  },
  "dependencies": {
    "@mantine/core": "8.3.8",
    "@mantine/hooks": "8.3.8",
    "lucide-react": "^0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.58.2",
    "@stylistic/eslint-plugin": "6.0.1",
    "@types/node": "26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.1.1",
    "@yarnpkg/cli-dist": "4.17.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "7.3.2"
  },
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#shared/contracts": "./shared/contracts/index.ts"
  }
}
