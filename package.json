{
  "name": "buro",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/start-dev.mjs",
    "dev": "vite --host 127.0.0.1 --port 4317",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4327 --strictPort",
    "check:ui": "node scripts/check-ui.cjs",
    "check:production": "node scripts/check-production.cjs",
    "daemon": "node daemon/main.ts",
    "cli": "node cli/main.ts",
    "test:core": "node --test tests/*.test.ts",
    "typecheck": "tsc -p agent/contracts/tsconfig.json && tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "check:service": "node scripts/check-service.cjs",
    "test": "npm run test:core",
    "check:projects": "node scripts/check-projects.cjs",
    "check:setup": "node scripts/check-project-setup.cjs",
    "check:appearance": "node scripts/check-appearance.cjs",
    "check:resources": "node scripts/check-resources.cjs",
    "format": "prettier --write src clients protocol tsconfig.json tsconfig.server.json",
    "format:check": "prettier --check src clients protocol tsconfig.json tsconfig.server.json",
    "check:context": "node scripts/check-context-materials.cjs",
    "check:localization": "node scripts/check-localization.cjs",
    "docs:screenshots": "node scripts/screenshot-docs.cjs"
  },
  "dependencies": {
    "@mantine/core": "8.3.8",
    "@mantine/hooks": "8.3.8",
    "cordis": "4.0.0-rc.12",
    "lucide-react": "^0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.1.1",
    "@yarnpkg/cli-dist": "4.17.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  },
  "engines": {
    "node": ">=24"
  }
}
