{
  "name": "buro",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/start-dev.mjs",
    "dev": "vite --host 127.0.0.1 --port 4317",
    "daemon": "node daemon/main.ts",
    "cli": "node cli/main.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4327 --strictPort",
    "typecheck": "tsc -p agent/contracts/tsconfig.json && tsc -p agent/providers/tsconfig.json && tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "node --test tests/*.test.ts",
    "check:ui": "node --test tests/modules-ui.test.ts",
    "format": "prettier --write src modules agent daemon cli scripts tests *.json vite.config.ts",
    "format:check": "prettier --check src modules agent daemon cli scripts tests *.json vite.config.ts",
    "evaluate:model": "node scripts/evaluate-model.ts"
  },
  "dependencies": {
    "@mantine/core": "8.3.8",
    "@mantine/hooks": "8.3.8",
    "lucide-react": "^0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.1.1",
    "@yarnpkg/cli-dist": "4.17.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  },
  "engines": {
    "node": ">=24"
  }
}
